(
    version: 1,
    metadata: (
        name: "Sample Scene",
        author: "rusty_engine",
        description: "Default scene with hierarchy, components, and embedded logic graph.",
    ),
    layers: [
        (
            layer_id: 1,
            name: "Main",
            order: 0,
            visible: true,
            locked: false,
        ),
        (
            layer_id: 2,
            name: "Foreground",
            order: 1,
            visible: true,
            locked: false,
        ),
    ],
    objects: [
        (
            object_id: 1,
            parent: None,
            layer_id: 1,
            name: "Camera",
            tags: ["camera"],
            components: (
                transform: (x: 0.0, y: 0.0, rotation_radians: 0.0, scale_x: 1.0, scale_y: 1.0),
                sprite: None,
                collider: None,
                audio: None,
                camera: Some((zoom: 1.0, near: -1000.0, far: 1000.0, clear_color_rgba: (16, 20, 28, 255))),
                script: None,
                custom_properties: {},
                render_effect: None,
            ),
        ),
        (
            object_id: 2,
            parent: None,
            layer_id: 2,
            name: "Hero",
            tags: ["player"],
            components: (
                transform: (x: -80.0, y: 10.0, rotation_radians: 0.0, scale_x: 1.0, scale_y: 1.0),
                sprite: Some((texture_asset: "assets/basic_shapes/square.ron", width: 64, height: 64, tint_rgba: (255, 255, 255, 255), layer_order: 10)),
                collider: Some((shape: "circle", radius: 16.0, width: 32.0, height: 32.0, is_sensor: false)),
                audio: Some((asset: "assets/audio/jump.ogg", volume: 0.8, looping: false, spatial_blend: 0.0)),
                camera: None,
                script: Some((script_asset: "assets/scripts/player_controller.rhai", entry: "update", frame_phase: "gameplay")),
                custom_properties: {
                    "health": "100",
                    "speed": "4.2",
                },
                render_effect: Some((material: "default", effect_tags: ["outline"])),
            ),
        ),
    ],
    graph: (
        version: 2,
        nodes: [
            (
                id: 1,
                name: "start",
                kind: GameplayEvent,
                target: Cpu,
                dependencies: [],
                settings: {},
                gpu_bindings: [],
                compute: None,
                fallback_policy: Cpu,
                gpu_resource_states: [],
                shader_entry: None,
                shader_profile: None,
                payload: Some(GameplayEvent((event_name: "on_update"))),
            ),
            (
                id: 2,
                name: "player_logic",
                kind: ScriptBehavior,
                target: Cpu,
                dependencies: [1],
                settings: {
                    "script_asset": "assets/scripts/player_controller.rhai",
                    "script_entry": "update",
                    "script_phase": "gameplay",
                },
                gpu_bindings: [],
                compute: None,
                fallback_policy: Cpu,
                gpu_resource_states: [],
                shader_entry: None,
                shader_profile: None,
                payload: Some(ScriptBehavior((
                    script_asset: "assets/scripts/player_controller.rhai",
                    entry: "update",
                    frame_phase: "gameplay",
                ))),
            ),
            (
                id: 3,
                name: "sprite_batch",
                kind: RenderPass,
                target: Gpu,
                dependencies: [2],
                settings: {
                    "sprite_count": "64",
                    "blend": "alpha",
                    "target_resource": "frame_color",
                    "target_width": "1920",
                    "target_height": "1080",
                },
                gpu_bindings: [],
                compute: None,
                fallback_policy: Cpu,
                gpu_resource_states: [],
                shader_entry: Some("vs_main"),
                shader_profile: Some("ps_6_0"),
                payload: Some(RenderPass((
                    target_resource: "frame_color",
                    target_width: 1920,
                    target_height: 1080,
                    sprite_count: 64,
                    blend: "alpha",
                ))),
            ),
        ],
    ),
    editor_state: (
        selected_object_ids: [2],
        selected_layer_id: Some(2),
        viewport_pan: (0.0, 0.0),
        viewport_zoom: 1.0,
    ),
)
